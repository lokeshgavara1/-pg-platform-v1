# Copy to .env and fill in. Never commit .env.
# These defaults are for LOCAL DEVELOPMENT. Servers get production settings from deploy/setup-server.sh.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pg_platform?schema=public"
# Separate database used by `npm test` (it is wiped before each run).
TEST_DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pg_platform_test?schema=public"

PORT=4000
# Use 127.0.0.1 on servers so only the reverse proxy (Caddy) can reach the API.
HOST=0.0.0.0
NODE_ENV=development
# Public URL of this backend; used to build signed file URLs (and gateway links, if any).
PUBLIC_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Where each app lives; used in one-time login links (WhatsApp, admin CLI).
OWNER_APP_URL=http://localhost:5173
TENANT_APP_URL=http://localhost:5174
ADMIN_APP_URL=http://localhost:5175

# Generate each with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
OTP_HASH_SECRET=
FILE_SIGNING_SECRET=

# Free "Continue with Google" via Firebase Auth (Spark plan). The project id is public.
FIREBASE_PROJECT_ID=

# Each of these has a development-only value that the server REFUSES with NODE_ENV=production:
#   SMS_PROVIDER     console = show/print the OTP (dev only) | none = no OTP login (Google only)
#   PAYMENT_PROVIDER fake = sandbox checkout (dev only) | none = direct UPI + cash | razorpay
#   ESIGN_PROVIDER   dev = OTP test signature (dev only) | none = sign on paper
SMS_PROVIDER=console
PAYMENT_PROVIDER=fake
ESIGN_PROVIDER=dev
FAKE_GATEWAY_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# inapp = in-app notification feed; fcm = Firebase Cloud Messaging (needs FCM_SERVER_KEY)
PUSH_PROVIDER=inapp
FCM_SERVER_KEY=
# Private file storage directory (KYC, photos, PDFs). Never serve it statically.
STORAGE_DIR=./storage
# Run the in-process scheduler (invoices, reminders, reservation expiry)
JOBS_ENABLED=true
